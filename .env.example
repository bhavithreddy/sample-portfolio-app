# DevOps Portfolio Application Environment Configuration
# Copy this file to .env and update with your values

# Application Settings
PORT=8080
ENV=production

# Timezone
TZ=UTC

# Your Personal Information (Replace with your details)
YOUR_NAME=YOUR_NAME
YOUR_EMAIL=your.email@example.com
YOUR_GITHUB=your-github-username
YOUR_LINKEDIN=your-linkedin-profile
YOUR_HANDLE=your-twitter-handle

# Calendly Integration (Optional)
CALENDLY_URL=https://calendly.com/your-name

# Security - Keep these secret!
# API Keys for any external services you integrate
# EXTERNAL_API_KEY=your_key_here

# Docker Build Arguments
DOCKER_IMAGE_NAME=devops-portfolio
DOCKER_IMAGE_TAG=latest
REGISTRY=docker.io

# Kubernetes Namespace (for deployment)
K8S_NAMESPACE=default

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_CONTACT_FORM=true

# External Services (Optional)
# GITHUB_TOKEN=your_github_token
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password